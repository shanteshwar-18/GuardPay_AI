# ─── Copy this file to .env and fill in your secrets ─────────────────────────
# NEVER commit the .env file — it is in .gitignore

# ── Groq (Llama 3 NLP / urgency classification) ──────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Twilio (IVR trusted-contact call) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Supabase (reputation network, beneficiary cache, feedback) ────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── MongoDB (alternative / fallback data layer) ───────────────────────────────
MONGODB_URI=mongodb://localhost:27017/guardpay

# ── Bank / PSP Alert (mock server for demo) ───────────────────────────────────
BANK_ALERT_ENDPOINT=http://localhost:9000/fraud-alert

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Risk Score Thresholds (defaults, can override) ────────────────────────────
RISK_THRESHOLD_WARNING=40
RISK_THRESHOLD_ELEVATED=70
RISK_THRESHOLD_INTERCEPT=90

# Demo mode — set true ONLY for hackathon/demo machines, never in production.
GUARDPAY_DEMO_MODE=false
