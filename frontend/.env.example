# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file to .env and update values for your local setup.
# NEVER commit .env — it is covered by .gitignore.

# ── Backend API Base URL (Shanteshwar's FastAPI instance) ─────────────────────
API_BASE_URL=http://localhost:8000

# ── WebSocket Base URL (for live audio streaming) ─────────────────────────────
WS_BASE_URL=ws://localhost:8000

# ── Default Language (en-IN | hi-IN | mr-IN | ta-IN) ─────────────────────────
DEFAULT_LANGUAGE=en-IN

# ── Senior Citizen Mode (true | false) ────────────────────────────────────────
SENIOR_MODE_DEFAULT=false
