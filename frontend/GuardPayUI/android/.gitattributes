# Ensure gradlew keeps LF line endings on all platforms
gradlew text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.md text eol=lf
*.py text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf