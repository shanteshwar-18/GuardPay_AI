yarn-debug.log*
yarn-error.log*

# React Native
.metro-health-check*
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Android
android/app/debug
android/app/profile
android/app/release
android/keystores/
*.keystore
!debug.keystore
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/.idea/

# iOS
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
